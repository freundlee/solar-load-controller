# ---- Anker Solix credentials ----
ANKER_EMAIL=
ANKER_PASSWORD=
ANKER_COUNTRY=DE

# ---- IOMeter ----
IOMETER_HOST=192.168.xxx.xxx

# ---- Push API keys ----
# Used by the home LAN pusher (local_pusher/) and/or ESP32 bridge.
# Set one or both; IOMETER_PUSH_KEY takes priority over ESP32_API_KEY for /api/iometer/push.
# aL3j38JLLfb2l2jvNmA
ESP32_API_KEY=change_me_strong_secret
IOMETER_PUSH_KEY=change_me_strong_secret

# ---- Timezone ----
TZ=Europe/Berlin
